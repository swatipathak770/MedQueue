# Template only: replace every password and secret before starting Compose.
MYSQL_DATABASE=medqueue
MYSQL_ROOT_PASSWORD=replace-with-a-strong-local-root-password
DB_USERNAME=medqueue_app
DB_PASSWORD=replace-with-a-strong-local-password
DB_URL=jdbc:mysql://mysql:3306/medqueue?useSSL=false&serverTimezone=Asia/Kolkata&allowPublicKeyRetrieval=true
JWT_SECRET=replace-with-base64-encoded-random-secret-of-at-least-32-bytes
JWT_EXPIRATION_SECONDS=3600
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost
BOOTSTRAP_ADMIN_EMAIL=admin@example.test
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-12-character-or-longer-password
VITE_API_URL=
VITE_WS_URL=
