# Template only: replace every REPLACE_* value before validation or use.
# Keep the real file outside source control. Compose does not fetch AWS secrets itself.
DB_URL=jdbc:mysql://REPLACE_WITH_PRIVATE_RDS_ENDPOINT:3306/medqueue?serverTimezone=UTC
DB_USERNAME=REPLACE_WITH_LEAST_PRIVILEGE_DATABASE_USER
DB_PASSWORD=REPLACE_WITH_UNIQUE_STRONG_DATABASE_PASSWORD
RDS_TRUSTSTORE_PATH=/opt/medqueue/certs/rds-truststore.p12
RDS_TRUSTSTORE_PASSWORD=REPLACE_WITH_TRUSTSTORE_PASSWORD
JWT_SECRET=REPLACE_WITH_BASE64_SECRET_DECODING_TO_AT_LEAST_32_RANDOM_BYTES
JWT_EXPIRATION_SECONDS=3600
CORS_ALLOWED_ORIGINS=https://app.example.com

# Replace with repository@sha256:<64 hex characters> references from the release.
MEDQUEUE_BACKEND_IMAGE=REPLACE_WITH_ECR_BACKEND_DIGEST_REFERENCE
MEDQUEUE_FRONTEND_IMAGE=REPLACE_WITH_ECR_FRONTEND_DIGEST_REFERENCE

# Private IPv4 assigned to the EC2 network interface and reachable from the ALB.
WEB_BIND_ADDRESS=10.0.1.25
WEB_PORT=80

# Per-backend-instance authentication request limits. Values are shared across clients
# reaching the same ALB node; see docs/AUTH_RATE_LIMITING.md before tuning.
AUTH_LOGIN_RATE_LIMIT=300
AUTH_LOGIN_RATE_WINDOW_SECONDS=300
AUTH_REGISTER_RATE_LIMIT=120
AUTH_REGISTER_RATE_WINDOW_SECONDS=3600

# Optional only for initial admin bootstrap. The production password must be explicit,
# non-placeholder, and at least 20 characters; remove both values after creation.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
